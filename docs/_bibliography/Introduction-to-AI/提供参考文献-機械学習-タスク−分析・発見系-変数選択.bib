@article{GeNote2011,
  title = {A note on the complexity of {{Lpminimization}}},
  author = {Ge, Dongdong and Jiang, Xiaoye and Ye, Yinyu},
  date = {2011-10-01},
  journaltitle = {Mathematical Programming},
  shortjournal = {Math. Program.},
  volume = {129},
  number = {2},
  pages = {285--299},
  issn = {1436-4646},
  doi = {10.1007/s10107-011-0470-2},
  url = {https://doi.org/10.1007/s10107-011-0470-2},
  urldate = {2024-08-01},
  abstract = {We discuss the Lp(0 ≤ p {$<$} 1) minimization problem arising from sparse solution construction and compressed sensing. For any fixed 0~{$<~$}p~{$<~$}1, we prove that finding the global minimal value of the problem is strongly NP-Hard, but computing a local minimizer of the problem can be done in polynomial time. We also develop an interior-point potential reduction algorithm with a provable complexity bound and demonstrate preliminary computational results of effectiveness of the algorithm.},
  langid = {english},
  keywords = {90C26,90C51,Global optimization,Interior-point method,Nonconvex programming,Sparse solution reconstruction},
  file = {/Users/teshima/Zotero/storage/XNTRV327/Ge et al. - 2011 - A note on the complexity of Lpminimization.pdf}
}

