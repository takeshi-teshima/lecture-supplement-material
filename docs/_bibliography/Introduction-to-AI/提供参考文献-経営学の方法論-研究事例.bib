@article{ZamanouMoving1994,
  title = {Moving toward participation and involvement: {{Managing}} and measuring organizational culture},
  shorttitle = {Moving toward participation and involvement},
  author = {Zamanou, Sonia and Glaser, Susan R.},
  date = {1994},
  journaltitle = {Group \& Organization Management},
  volume = {19},
  number = {4},
  pages = {475--502},
  publisher = {Sage Publications},
  location = {US},
  issn = {1552-3993},
  doi = {10.1177/1059601194194005},
  abstract = {Describes a communication intervention program designed to change the culture of a 322-employee governmental organization from hierarchical and authoritarian to participative and involved. Cultural shift was measured through a triangulation approach. Specifically, questionnaires, interview data, and direct observation were combined to study the areas of cultural change. Ss completed the Organizational Culture Scale (OCS) before the intervention and a representative sample was interviewed. Then, the entire organization participated in an organizational development program. Two years later, Ss again completed the OCS and were interviewed. Also, Ss were directly observed in the workplace. Results suggest that the organization changed significantly in the following dimensions: information flow, involvement, morale, and meetings. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  keywords = {Communication Skills Training,Longitudinal Studies,Organizational Change,Organizational Climate,Teams},
  file = {/Users/teshima/Zotero/storage/ZTSMAVV8/Zamanou and Glaser - 1994 - Moving toward participation and involvement Manag.pdf}
}
