  file = {/Users/teshima/Zotero/storage/L53YPUJZ/Min et al. - 2022 - Rethinking the Role of Demonstrations What Makes .pdf}
}

@online{MuennighoffS12025,
  title = {s1: {{Simple}} test-time scaling},
